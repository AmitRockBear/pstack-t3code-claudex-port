{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "schedule": "user-invocable-only"
  },
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR\"/hooks/git-backup-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR\"/hooks/draft-and-stash-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
